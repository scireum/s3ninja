<i:arg name="buckets"
       type="List"/>
<i:arg name="baseUrl"
       type="String"/>
<i:arg name="accessKey"
       type="String"/>
<i:arg name="secretKey"
       type="String"/>

<t:page title="Start">
    <i:block name="breadcrumbs"/>

    <i:block name="page-header">
        <i:invoke template="/templates/header.html.pasta"
                  title="S3 ninja"
                  subtitle="@toUserString(config('product.tagLine'))"/>
    </i:block>

    <script type="text/javascript">
        const CSRF_TOKEN = '@escapeJS(part(CSRFHelper.class).getCSRFToken())';

        function resolveTextfield() {
            return document.querySelector('#create-bucket div input[name=bucketName]')
        }

        function checkBucketName() {
            return new Promise((resolve, reject) => {
                // make sure we have the text field
                const textfield = resolveTextfield();
                if (!textfield) {
                    reject(undefined);
                }

                // make sure we have a proper name
                // https://docs.aws.amazon.com/AmazonS3/latest/dev/BucketRestrictions.html
                const name = textfield.value;
                if (!name || name.trim() !== name || !/^[a-z\d][a-z\d\-.]{1,61}[a-z\d]$/.test(name)) {
                    reject(name);
                }

                resolve(name);
            });
        }

        /**
         * Checks the form for errors and styles the input accordingly.
         */
        function checkForm() {
            checkBucketName().then(name => {
                // remove style class `error`
                const textfield = resolveTextfield();
                if (textfield) {
                    textfield.classList.remove('sci-border-red');
                }
            }).catch(name => {
                // add style class `error` unless empty
                const textfield = resolveTextfield();
                if (textfield) {
                    textfield.classList.remove('sci-border-red');
                    if (name) {
                        textfield.classList.add('sci-border-red');
                    }
                }
            });
        }

        /**
         * Checks the form for errors and submits the form if everything is fine.
         */
        function submitForm() {
            checkBucketName().then(name => {
                const _form = document.createElement('form');
                _form.method = 'post';
                _form.action = '/ui/' + encodeURIComponent(name) + '?create';

                const _csrfToken = document.createElement('input');
                _csrfToken.type = 'hidden';
                _csrfToken.name = 'CSRFToken';
                _csrfToken.value = CSRF_TOKEN;
                _form.appendChild(_csrfToken);

                document.body.appendChild(_form);
                _form.submit();
            }).catch(() => {
                // ignore, error has already been indicated while typing
            });
        }

    </script>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <dl class="mb-3">
                        <dt>Storage Path</dt>
                        <dd class="mb-0">
                            <small>@baseUrl</small>
                        </dd>
                    </dl>
                    <dl class="mb-3">
                        <dt>Access Key</dt>
                        <dd class="mb-0">
                            <small>@accessKey</small>
                        </dd>
                    </dl>
                    <dl class="mb-0">
                        <dt>Secret Key</dt>
                        <dd class="mb-0">
                            <small>@secretKey</small>
                        </dd>
                    </dl>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Session Token</h5>
                    <p class="text-muted small mb-3">
                        Generate a session token for authenticating presigned POST requests and other operations.
                        Token is valid for 24 hours.
                    </p>
                    <dl class="mb-3" id="token-container" style="display: none;">
                        <dt>Token</dt>
                        <dd class="mb-0">
                            <small class="text-break" id="session-token-value"></small>
                        </dd>
                    </dl>
                    <button class="btn btn-primary btn-sm" onclick="generateSessionToken()">
                        <i class="fa-solid fa-key"></i> Generate Token
                    </button>
                    <button class="btn btn-outline-secondary btn-sm ms-2" onclick="copyTokenToClipboard()" id="copy-token-btn" style="display: none;">
                        <i class="fa-solid fa-copy"></i> Copy
                    </button>
                    <div class="alert alert-info mt-3 small" id="token-usage" style="display: none;">
                        <strong>Usage:</strong><br>
                        • Header: <code>X-Session-Token: [token]</code><br>
                        • Header (AWS): <code>X-Amz-Security-Token: [token]</code><br>
                        • Query param: <code>?sessionToken=[token]</code><br>
                        • Form field: <code>X-Amz-Security-Token=[token]</code>
                    </div>
                </div>
            </div>
            <script type="text/javascript">
                let currentToken = null;

                function generateSessionToken() {
                    const params = new URLSearchParams();
                    params.append('CSRFToken', CSRF_TOKEN);

                    fetch('/.api/generate-session-token', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: params
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                currentToken = data.token;
                                document.getElementById('session-token-value').textContent = data.token;
                                document.getElementById('token-container').style.display = 'block';
                                document.getElementById('copy-token-btn').style.display = 'inline-block';
                                document.getElementById('token-usage').style.display = 'block';
                            } else {
                                alert('Failed to generate token');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error generating token');
                        });
                }

                function copyTokenToClipboard() {
                    if (currentToken) {
                        navigator.clipboard.writeText(currentToken).then(() => {
                            const btn = document.getElementById('copy-token-btn');
                            const originalHtml = btn.innerHTML;
                            btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
                            setTimeout(() => {
                                btn.innerHTML = originalHtml;
                            }, 2000);
                        }).catch(err => {
                            console.error('Failed to copy:', err);
                            alert('Failed to copy token to clipboard');
                        });
                    }
                }
            </script>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex flex-column flex-md-row align-items-md-center mb-3">
                        <div class="flex-grow-1">
                            <h5 class="mb-1">Presigned POST Workbench</h5>
                            <p class="text-muted small mb-2">
                                Generate presigned POST payloads and fire real uploads without Maven tooling.
                            </p>
                            <ul class="text-muted small ps-3 mb-3">
                                <li>Fills policy, signature, and fields automatically</li>
                                <li>Allows one-click token generation</li>
                                <li>Includes an inline upload tester hitting this instance</li>
                            </ul>
                        </div>
                        <div class="text-md-end">
                            <a class="btn btn-primary" href="/ui/presigned-post">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Open Presigned POST UI
                            </a>
                        </div>
                    </div>
                    <hr class="my-4"/>
                    <div class="row">
                        <div class="col-8 col-xl-9">
                            <form id="create-bucket"
                                  onsubmit="submitForm(); return false;">
                                <div class="input-group">
                                    <input type="text"
                                           name="bucketName"
                                           class="form-control"
                                           placeholder="New Bucket…"
                                           autofocus
                                           oninput="checkForm();"/>
                                    <a class="btn btn-outline-secondary"
                                       onclick="submitForm();">
                                        <i class="fa-solid fa-plus"></i></a>
                                </div>
                            </form>
                        </div>
                        <div class="col-4 col-xl-3 d-flex flex-row justify-content-end">
                            <a class="btn btn-outline-secondary"
                               href="/ui">
                                <i class="fa-solid fa-arrows-rotate"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table mb-0">
                        <thead>
                        <tr>
                            <th>
                                Bucket
                            </th>
                            <th>
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        <i:if test="buckets.isEmpty()">
                            <tr>
                                <td colspan="2"
                                    class="border-0 border-bottom text-muted">
                                    (No buckets)
                                </td>
                            </tr>
                        </i:if>
                        <i:for type="ninja.Bucket"
                               var="bucket"
                               items="buckets">
                            <tr class="@if(bucket.isPrivate()) { sci-left-border-red } else { sci-left-border-green }">
                                <td class="border-0 border-top">
                                    <a class="@if(bucket.isPrivate()) { sci-text-red } else { sci-text-green }"
                                       href="/ui/@bucket.getEncodedName()">@bucket.getName()</a><br>
                                    <i:if test="bucket.isPrivate()">
                                        <small class="text-muted small">private</small>
                                        <i:else>
                                            <small class="text-muted small">public</small>
                                        </i:else>
                                    </i:if>
                                </td>
                                <td class="border-0 border-top text-end pe-0">
                                    <t:additionalActions label="Actions">
                                        <i:if test="bucket.isPrivate()">
                                            <t:dropdownItem url="@apply('/ui/%s?make-public&return=%%2Fui', bucket.getEncodedName())"
                                                            sendPostRequest="true"
                                                            icon="fa-solid fa-lock-open"
                                                            label="Make public" />
                                            <i:else>
                                                <t:dropdownItem url="@apply('/ui/%s?make-private&return=%%2Fui', bucket.getEncodedName())"
                                                                sendPostRequest="true"
                                                                icon="fa-solid fa-lock"
                                                                label="Make private" />
                                            </i:else>
                                        </i:if>
                                        <t:dropdownDeleteItem url="@apply('/ui/%s?delete', bucket.getEncodedName())" />
                                    </t:additionalActions>
                                </td>
                            </tr>
                        </i:for>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <i:block name="footer">
        <i:invoke template="/templates/footer.html.pasta"/>
    </i:block>
</t:page>
